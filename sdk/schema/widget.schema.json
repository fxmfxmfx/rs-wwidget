{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rs-wwidget package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "enum": [
          "clock",
          "calendar",
          "system"
        ]
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      },
      "prefixItems": [
        {
          "type": "string",
          "pattern": "[^\\s]"
        }
      ]
    },
    "frame": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\u0000)(?=.*\\S)[\\s\\S]+$"
    },
    "width": {
      "type": "integer",
      "minimum": 32,
      "maximum": 8192,
      "default": 300
    },
    "height": {
      "type": "integer",
      "minimum": 32,
      "maximum": 8192,
      "default": 178
    },
    "protocol": {
      "enum": [
        1,
        2
      ],
      "default": 1
    },
    "render_mode": {
      "enum": [
        "canvas",
        "external"
      ],
      "default": "canvas"
    },
    "decoration": {
      "enum": [
        "card",
        "none"
      ],
      "default": "card"
    },
    "input": {
      "enum": [
        "title",
        "all",
        "none",
        "interactive"
      ],
      "default": "title"
    },
    "keyboard": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "drag_height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "layer": {
      "enum": [
        "background",
        "bottom",
        "top",
        "overlay"
      ],
      "default": "bottom"
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "pattern": "^[^=\\u0000]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    },
    "watch_files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "restart_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 30
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 60
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "oneOf": [
    {
      "required": [
        "command"
      ],
      "not": {
        "required": [
          "frame"
        ]
      }
    },
    {
      "required": [
        "frame"
      ],
      "not": {
        "required": [
          "command"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "input": {
            "const": "interactive"
          }
        },
        "required": [
          "input"
        ]
      },
      "then": {
        "required": [
          "command",
          "protocol"
        ],
        "properties": {
          "protocol": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "keyboard": {
            "const": true
          }
        },
        "required": [
          "keyboard"
        ]
      },
      "then": {
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "const": "interactive"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "render_mode": {
            "const": "external"
          }
        },
        "required": [
          "render_mode"
        ]
      },
      "then": {
        "required": [
          "command",
          "input"
        ],
        "properties": {
          "input": {
            "const": "none"
          },
          "keyboard": {
            "const": false
          }
        }
      }
    }
  ]
}
